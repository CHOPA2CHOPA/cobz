        "filter_words_where": "text",
        "filter_words_save": 0,
        "filter_words_list": "",
        "user_replace_on": 1,
        "replace": {
          "text": [
            { "search": "~<div class=\"post-toc\".*?</div>~is", "replace": "", "limit": -1 },
            { "search": "~<script.*?</script>~is", "replace": "", "limit": -1 }
          ]
        },
        "image_save": 1,
        "image_resize": 1,
        "img_text_crop": 0,
        "text_pic_width": 800,
        "text_pic_height": 0,
        "text_pic_quality": 85,
        "image_name_from_title_on": 1,
        "image_alt_make_on": 1,
        "image_alt_replace": 1,
        "image_alt_from_attr_title": 1,
        "image_class_name_on": 1,
        "image_class_name_custom": "wp-block-image",
        "image_attr_delete": "srcset,sizes,loading,data-src,data-lazy-src,class",
        "imageHtmlCode": "<img src=\"%PATH%\" %ADDS% %ATTR% />",
        "max_images": 5,
        "limit_image_output_on": 0,
        "image_nextpage_quan": 0,
        "post_thumb_on": 1,
        "delFirstPic": 0,
        "no_save_without_pic": 0,
        "post_tags_on": 1,
        "tags_mode": 0,
        "tagsScrape": "<meta property=\"article:tag\" content=\"(.*?)\"",
        "tagsScrapeSeparator": ",",
        "tagsScrapeCount": 5,
        "post_date_on": 1,
        "post_date_scrape": "<time[^>]*datetime=\"(.*?)\"",
        "post_date_type": "runtime",
        "template_full_text": "%FULL_TEXT%<p><small>Источник: <a href=\"%SOURCE%\" rel=\"nofollow noopener\" target=\"_blank\">BeInCrypto</a></small></p>",
        "post_status": "draft",
        "catid": [],
