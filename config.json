        "translate2": { "on": 0, "provider": "deepl", "lang": "en|ru", "split": 4000 },
        "nosave_if_not_translate": 0,
        "synonymizeEnabled": 0,
        "minSynonymPercentage": 30,
        "ignoreRecordOnSynonymizeError": 0
      }
    }
